{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lithic 3DS Transfer Limits API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transfer Limits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get transfer limits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lithic.com/v1/transfer_limits"
          },
          "docs": "Get transfer limits for a specified date"
        }
      ]
    }
  ],
  "bundled": true
}